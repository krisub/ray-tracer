SBT-raytracer 1.0

// camera looking down
camera {
    position = (0, 0, 5);
    viewdir = (0, 0, -1);
    updir = (0, 1, 0);
    aspectratio = 1;
}

// point light located slightly up and to the right
point_light {
    position = (2, 2, 2);
    color = (1, 1, 1);
    constant_attenuation_coeff = 0.25;
    linear_attenuation_coeff = 0.003;
    quadratic_attenuation_coeff = 0.00006;
}

// (two big triangles making a square)
polymesh {
    material = {
        diffuse = (0.5, 0.5, 0.5);
    }
    points = ( (-10,-2,-10), (10,-2,-10), (10,-2,10), (-10,-2,10) );
    faces = ( (0, 1, 2), (0, 2, 3) );
}

// (triangle floating above the two big triangles)
polymesh {
    material = {
        diffuse = (1, 0, 0);
    }
    points = ( (-1, 0, 0), (1, 0, 0), (0, 2, 0) );
    faces = ( (0, 1, 2) );
}
